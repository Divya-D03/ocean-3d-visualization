# Ocean 3D Explorer - Environment Configuration

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# INCOIS ERDDAP Integration
# Official INCOIS ERDDAP endpoint
ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap
# Set to False because INCOIS ERDDAP uses Indian NIC SSL certificates
ERDDAP_VERIFY_SSL=false
ERDDAP_TIMEOUT_SECONDS=25.0

# Datasets
DATASET_ARGO_FLOATS=Indian_ARGO_Floats
DATASET_GRIDDED_VAM=incois_argo_mnt_VAM
DATASET_CURRENTS=incois_valueadded_products_datasets

# PostgreSQL + PostGIS (Optional / Production)
DATABASE_URL=postgresql+psycopg2://ocean:ocean@localhost:5432/oceandb
ENABLE_DB_FALLBACK=true

# Caching
CACHE_TTL_SECONDS=7200
